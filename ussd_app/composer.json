{
    "name": "finance-tracker/ussd",
    "description": "Finance Tracker USSD Application",
    "type": "project",
    "require": {
        "php": "^8.0",
        "illuminate/database": "^10.0",
        "nesbot/carbon": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}